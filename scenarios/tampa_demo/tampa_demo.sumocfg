<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="tampa_evtol.net.xml.gz"/>
        <route-files value="osm.passenger.rou.xml,tampa_evtol.rou.xml"/>
        <additional-files value="osm.poly.xml.gz,tampa_evtol_air.poly.xml"/>
        <gui-settings-file value="tampa_demo.view.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="1600"/>
    </time>
    <processing>
        <ignore-route-errors value="true"/>
    </processing>
    <report>
        <verbose value="true"/>
        <no-step-log value="true"/>
    </report>
</configuration>
